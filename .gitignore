# Secrets and local configuration
.env
.env.*
!.env.example

# Capacitor / Android build output. The native project is committed so the app
# can be built from a clean clone, but everything Gradle or `cap sync`
# regenerates is not — including local.properties, which holds a machine-specific
# SDK path, and assets/public, which is just a copy of the web build.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/
*.apk
*.aab
*.keystore
*.jks

# OMR eval and training: downloaded sources, rendered pages, tools and models
# in progress are reproducible from the scripts, so none of it is committed.
omr-eval/data/
omr-eval/private/
omr-eval/reports/*.json
omr-train/.tools/
omr-train/.venv/
omr-train/data/
omr-train/runs/
__pycache__/
